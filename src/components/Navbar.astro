---
const pathname = Astro.url.pathname;
const links = [
  { name: 'Projects', href: '/Me/projects' },
  { name: 'Experience', href: '/Me/experience' },
  { name: 'Blogs', href: '/Me/blogs' }
];
---

<header class="fixed top-0 left-0 right-0 bg-paper/90 backdrop-blur-md border-b border-line z-1000 transition-all duration-300">
  <div class="max-w-7xl w-full mx-auto px-6 py-5 flex justify-between items-center">
    <a href="/Me" class="font-display text-xl font-semibold tracking-tight text-ink">
      Home
    </a>

    <button class="md:hidden p-2 text-ink hover:text-signal transition-colors cursor-pointer" aria-label="Toggle menu" id="menu-btn">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <nav class="hidden md:flex gap-9 items-center transition-all duration-300" id="nav-links">
      {links.map((link) => {
        const isActive = link.href === '/Me' ? pathname === '/Me' : pathname.startsWith(link.href);
        return (
          <a
            class={`font-mono text-sm tracking-wide py-2 flex items-center gap-2 text-graphite hover:text-ink transition-colors duration-300 ${isActive ? 'text-ink' : ''}`}
            href={link.href}
          >
            <span class={`w-1.5 h-1.5 rounded-full bg-signal transition-opacity duration-300 ${isActive ? 'opacity-100' : 'opacity-0'}`}></span>
            {link.name}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<style>
  /* Mobile menu logic using styling due to dynamic heights */
  @media (max-width: 768px) {
    #nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #fafaf9;
      display: flex;
      flex-direction: column;
      padding: 2rem;
      gap: 1.5rem;
      border-bottom: 1px solid #e3e1da;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
      clip-path: polygon(0 0, 100% 0, 100% 0, 0 0);
    }
    
    #nav-links.show {
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
    }
  }
</style>

<script>
  // Mobile menu logic
  function setupMenu() {
    const menuBtn = document.getElementById('menu-btn');
    const navLinks = document.getElementById('nav-links');

    if (menuBtn && navLinks) {
      menuBtn.addEventListener('click', () => {
        navLinks.classList.toggle('show');
      });
    }
  }

  setupMenu();
  document.addEventListener('astro:page-load', setupMenu);
</script>
