---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allBlogs = await getCollection('blogs');
---

<Layout title="Blogs | Portfolio">
  <section class="py-12">
    <h1 class="title">Blogs</h1>
    <div class="title-rule"></div>

    <div class="flex flex-col gap-8 max-w-3xl">
      {allBlogs.length > 0 ? (
        allBlogs.map((blog) => (
          <a href={`/blogs/${blog.id}`} class="card block group">
            <div class="mb-3">
              <span class="eyebrow">{blog.data.date}</span>
            </div>
            <h2 class="font-display text-2xl font-semibold mb-4 transition-colors duration-300 group-hover:text-signal">{blog.data.title}</h2>
            <p class="font-sans text-graphite mb-6 leading-relaxed">{blog.data.excerpt}</p>
            <span class="font-sans text-sm font-semibold text-ink flex items-center gap-2 opacity-80 transition-all duration-300 group-hover:opacity-100 group-hover:text-signal group-hover:translate-x-1">
              Read article →
            </span>
          </a>
        ))
      ) : (
        <div class="card bg-white border-dashed border-2 border-l-2 text-center py-16">
          <p class="font-sans text-lg text-graphite mb-2">No blogs published yet.</p>
          <p class="font-sans text-sm text-graphite/70">Check back later for my thoughts!</p>
        </div>
      )}
    </div>
  </section>
</Layout>
