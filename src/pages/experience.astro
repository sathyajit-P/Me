---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allExperience = await getCollection('experience');
---

<Layout title="Experience | Portfolio">
  <section class="py-12 max-w-3xl mx-auto">
    <h1 class="title">Experience</h1>
    <div class="title-rule"></div>

    <div class="relative pl-8 flex flex-col gap-12 before:content-[''] before:absolute before:left-0 before:top-2 before:h-full before:w-px before:bg-line">
      {allExperience.map((exp) => (
        <div class="relative card">
          <div class="absolute -left-[2.35rem] top-8 w-3 h-3 bg-signal rounded-full shadow-[0_0_0_4px_var(--color-paper)]"></div>
          <div>
            <span class="eyebrow inline-block mb-2">{exp.data.period}</span>
            <h2 class="font-display text-2xl font-semibold mb-1">{exp.data.role}</h2>
            <h3 class="font-display text-lg text-graphite font-medium mb-4">{exp.data.company}</h3>
            <p class="font-sans text-graphite leading-relaxed">{exp.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
