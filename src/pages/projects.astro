---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allProjects = await getCollection('projects');
---

<Layout title="Projects | Portfolio">
  <section class="py-12">
    <h1 class="title">Projects</h1>
    <div class="title-rule"></div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {allProjects.map((project) => (
        <div class="card flex flex-col h-full">
          <h2 class="font-display text-2xl font-semibold mb-3">{project.data.title}</h2>
          <p class="font-sans text-graphite mb-6 grow">{project.data.description}</p>

          {project.data.tags && (
            <div class="flex flex-wrap gap-2 mb-6">
              {project.data.tags.map((tag) => (
                <span class="font-mono text-xs px-2.5 py-1 bg-signal-soft text-signal rounded">
                  {tag}
                </span>
              ))}
            </div>
          )}

          <div class="flex flex-wrap gap-4 mt-auto">
            {project.data.link && (
              <a href={project.data.link} target="_blank" rel="noopener noreferrer" class="btn btn-primary px-4 py-2 text-sm">Website</a>
            )}
            {project.data.github && (
              <a href={project.data.github} target="_blank" rel="noopener noreferrer" class="btn btn-outline px-4 py-2 text-sm">
                GitHub Repo
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
