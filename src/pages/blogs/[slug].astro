---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const blogs = await getCollection('blogs');
  return blogs.map(blog => ({
    params: { slug: blog.id },
    props: { blog },
  }));
}

const { blog } = Astro.props;
const { Content } = await render(blog);
---

<Layout title={`${blog.data.title} | Blog`}>
  <article class="max-w-3xl mx-auto py-12">
    <header class="mb-12">
      <a href="/blogs" class="inline-block mb-8 font-mono text-sm text-graphite hover:text-signal transition-colors duration-300">
        ← Back to Blogs
      </a>
      <p class="eyebrow mb-4">{blog.data.date}</p>
      <h1 class="font-display text-4xl sm:text-5xl font-semibold leading-tight tracking-tight text-ink">
        {blog.data.title}
      </h1>
    </header>
    
    <div class="content markdown-body">
      <Content />
    </div>
  </article>
</Layout>

<style is:global>
  @reference "../../styles/global.css";

  .markdown-body {
    @apply text-lg leading-relaxed text-graphite;
  }

  .markdown-body h2 {
    @apply font-display text-3xl font-semibold text-ink mt-12 mb-4;
  }

  .markdown-body h3 {
    @apply font-display text-2xl font-semibold text-ink mt-10 mb-4;
  }

  .markdown-body p {
    @apply mb-6;
  }

  .markdown-body ul, .markdown-body ol {
    @apply mb-6 pl-6 list-disc;
  }

  .markdown-body li {
    @apply mb-2;
  }

  .markdown-body a {
    @apply text-signal underline decoration-transparent hover:decoration-signal transition-colors duration-300;
  }

  .markdown-body blockquote {
    @apply border-l-2 border-signal pl-4 ml-0 italic bg-white py-4 pr-4 rounded-r-md my-8;
  }
</style>
